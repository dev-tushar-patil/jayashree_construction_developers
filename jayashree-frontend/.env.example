# Frontend settings. Copy to .env.local if you need to change them. Nothing secret belongs here:
# every VITE_ value ends up in the public JavaScript bundle.

# Where the API lives when the site and API are on different origins in production,
# e.g. https://api.jayashreeconstruction.com . Leave empty when both are served from one domain
# (the recommended nginx setup in README.md) or during development.
#VITE_API_ORIGIN=

# Development only: where Vite forwards /api and /uploads.
#VITE_DEV_BACKEND=http://localhost:8070
