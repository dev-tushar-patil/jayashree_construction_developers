# Copy to .env (git-ignored) and fill in. Spring Boot loads it automatically on startup.
# Values are read as Java properties: do not wrap them in quotes.
# On a server you can set these as real environment variables instead.

# --- Required -------------------------------------------------------------
DB_PASSWORD=
# At least 32 characters. Generate one, e.g.  openssl rand -base64 48
JWT_SECRET=
# First admin account, created on startup only when no admin exists yet.
# Sign in with either the username or the email. Change the password from the admin panel afterwards.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Database (defaults shown) --------------------------------------------
#DB_URL=jdbc:mysql://localhost:3306/jayashree?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
#DB_USERNAME=root
#DB_POOL_SIZE=10

# --- Server ---------------------------------------------------------------
#SERVER_PORT=8070
# Comma-separated list of the website origins allowed to call the API.
#CORS_ALLOWED_ORIGINS=http://localhost:5170
#JWT_EXPIRY_HOURS=8
# Requests per minute, per IP, for login / enquiry / review submission.
#RATE_LIMIT_PER_MINUTE=15
# Sample projects, gallery photos and reviews, inserted only into empty tables.
# They can be removed in one click from the admin dashboard. Set to false before going live.
#SEED_SAMPLE_DATA=true
# Set to "framework" only behind a trusted reverse proxy (nginx, a load balancer...).
#FORWARD_HEADERS=none

# --- Image uploads --------------------------------------------------------
#STORAGE_TYPE=local
#UPLOAD_DIR=uploads
# Where browsers fetch uploads from. Change if a CDN or separate host serves the upload folder.
#UPLOAD_PUBLIC_BASE_URL=/uploads
#UPLOAD_MAX_FILE_SIZE=15MB
#UPLOAD_MAX_REQUEST_SIZE=80MB
#IMAGE_MAX_DIMENSION=2000
#IMAGE_THUMBNAIL_SIZE=800
#IMAGE_JPEG_QUALITY=0.84
